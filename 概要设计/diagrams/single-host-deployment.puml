@startuml
!pragma layout smetana
title FlowScape 首版单机部署
top to bottom direction
skinparam shadowing false
skinparam componentStyle rectangle
skinparam defaultFontName Microsoft YaHei
skinparam defaultFontSize 15
skinparam ArrowColor #455C70
skinparam nodesep 34
skinparam ranksep 46

node "本地工作站" as Host #F5F8FB {
  node "浏览器进程" as Browser #EAF4FF {
    artifact "M10 Web 控制台" as Console #FFFFFF
  }

  node "FlowScape 后端进程" as Backend #EAF4FF {
    component "M9 服务网关" as Gateway #FFFFFF
    component "M1 / M6 / M7 / M8\n校验、实验、运行与指标" as Application #FFFFFF
    component "M2–M5 仿真内核\n每个 run_id 持有独立状态" as Engine #FFFFFF

    Gateway --> Application : 进程内调用
    Application --> Engine : M7 分批推进
  }

  folder "本地实验目录" as Storage #E8F5EE {
    artifact "manifest.json · inputs/\nruns/<run_id>/ 事件、检查点与结果" as Files #FFFFFF
  }

  Browser <--> Backend : 本机 HTTP 命令与查询\nWebSocket 进度与事件通知
  Backend -right-> Storage : 本地文件读写
}
@enduml
